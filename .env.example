# Copy this file to `.env` and add your Razorpay public Key ID.
# Get it from https://dashboard.razorpay.com/app/keys -> API Keys -> Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Optional: URL of your backend endpoint that creates a Razorpay order.
# It should accept POST { amount, currency, receipt } and return { id: "order_..." }.
# This is REQUIRED for live (rzp_live_) payments. Test mode works without it.
# See src/lib/razorpay.ts for the exact request/response shape.
VITE_RAZORPAY_ORDER_API_URL=
